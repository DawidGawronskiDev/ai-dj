MUSIC_DIR=/absolute/path/to/prepared/music
STATE_DIR=/absolute/path/to/event/state
VENUE_UID=1000
VENUE_GID=1000
ICECAST_SOURCE_PASSWORD=replace-with-a-long-random-password
ICECAST_ADMIN_PASSWORD=replace-with-a-different-long-random-password
